# CockroachDB Cloud — Connect → General connection string
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# Cluster CA. Read from ~/.postgresql/root.crt locally; set the PEM inline when deploying
# somewhere without a home directory.
# COCKROACH_CA_PEM=

# Amazon Bedrock. Omit credentials to fall back to the deterministic local provider.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# Force the local embedding provider regardless of credentials.
# EMBEDDINGS=local
